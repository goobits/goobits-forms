{
	"name": "@goobits/ui",
	"version": "3.0.0",
	"description": "Comprehensive UI component library including forms, modals, menus, tooltips with validation, reCAPTCHA, and file uploads for Svelte 5",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "svelte-package && pnpm run build:clean",
		"build:clean": "find dist -type f -name '*.test.*' -delete",
		"prepublishOnly": "pnpm run build && pnpm run lint && pnpm run test:run",
		"test": "vitest run",
		"test:run": "vitest run",
		"test:leaks": "vitest run --detectAsyncLeaks --maxWorkers=1 --silent=passed-only src/lib/ui/ContactForm.a11y.test.ts src/lib/ui/DatePicker.a11y.test.ts src/lib/ui/Slider.a11y.test.ts",
		"test:heap": "vitest run --logHeapUsage --maxWorkers=1 --reporter=verbose src/lib/handlers/contactFormHandler.test.ts src/lib/ui/ContactForm.a11y.test.ts",
		"test:watch": "vitest --watch",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:a11y": "vitest run --reporter=verbose src/lib/ui/**/*.a11y.test.ts",
		"test:a11y:watch": "vitest --reporter=verbose src/lib/ui/**/*.a11y.test.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:codegen": "playwright codegen http://localhost:5173",
		"test:e2e:report": "playwright show-report",
		"validate:docs": "node tests/docs-validator.js",
		"validate": "pnpm run validate:docs",
		"lint": "eslint . --ext .js,.ts,.svelte",
		"format": "prettier --write .",
		"demo": "cd demo && pnpm run dev",
		"demo:build": "cd demo && pnpm run build",
		"demo:preview": "cd demo && pnpm run preview"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./ui": {
			"types": "./dist/ui/index.d.ts",
			"svelte": "./dist/ui/index.js",
			"default": "./dist/ui/index.js"
		},
		"./ui/*": {
			"svelte": "./dist/ui/*",
			"default": "./dist/ui/*"
		},
		"./ui/index.css": "./dist/ui/index.css",
		"./ui/menu": {
			"types": "./dist/ui/menu/index.d.ts",
			"svelte": "./dist/ui/menu/index.js",
			"default": "./dist/ui/menu/index.js"
		},
		"./ui/menu/*": {
			"svelte": "./dist/ui/menu/*",
			"default": "./dist/ui/menu/*"
		},
		"./ui/modals": {
			"types": "./dist/ui/modals/index.d.ts",
			"svelte": "./dist/ui/modals/index.js",
			"default": "./dist/ui/modals/index.js"
		},
		"./ui/modals/*": {
			"svelte": "./dist/ui/modals/*",
			"default": "./dist/ui/modals/*"
		},
		"./ui/tooltip": {
			"types": "./dist/ui/tooltip/index.d.ts",
			"svelte": "./dist/ui/tooltip/index.js",
			"default": "./dist/ui/tooltip/index.js"
		},
		"./config": {
			"types": "./dist/config/index.d.ts",
			"default": "./dist/config/index.js"
		},
		"./validation": {
			"types": "./dist/validation/index.d.ts",
			"default": "./dist/validation/index.js"
		},
		"./i18n": {
			"types": "./dist/i18n/index.d.ts",
			"default": "./dist/i18n/index.js"
		},
		"./services": {
			"types": "./dist/services/index.d.ts",
			"default": "./dist/services/index.js"
		},
		"./handlers": {
			"types": "./dist/handlers/index.d.ts",
			"default": "./dist/handlers/index.js"
		},
		"./handlers/contactFormHandler": {
			"types": "./dist/handlers/contactFormHandler.d.ts",
			"default": "./dist/handlers/contactFormHandler.js"
		},
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"default": "./dist/utils/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"dependencies": {
		"@goobits/keyboard": "workspace:*",
		"@goobits/security": "workspace:*",
		"@sveltejs/kit": "2.70.2",
		"formsnap": "^2.0.1",
		"svelte": "5.56.8",
		"sveltekit-superforms": "^2.30.2",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@aws-sdk/client-ses": "^3.0.0",
		"nodemailer": "^9.0.1"
	},
	"peerDependenciesMeta": {
		"nodemailer": {
			"optional": true
		},
		"@aws-sdk/client-ses": {
			"optional": true
		}
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"ui-components",
		"forms",
		"form",
		"contact-form",
		"validation",
		"recaptcha",
		"modals",
		"menus",
		"tooltips",
		"i18n",
		"internationalization",
		"form-builder",
		"form-components",
		"email-service",
		"rate-limiting"
	],
	"license": "MIT",
	"author": "GooBits",
	"homepage": "https://github.com/goobits/forms#readme",
	"bugs": {
		"url": "https://github.com/goobits/forms/issues"
	},
	"engines": {
		"node": ">=18.0.0",
		"pnpm": ">=9.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/goobits/forms.git"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@eslint/js": "^10.0.1",
		"@goobits/docs-engine": "^2.0.3",
		"@lucide/svelte": "^1.28.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^25.9.5",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"axe-core": "^4.12.1",
		"eslint": "^10.8.0",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"jest-axe": "^10.0.0",
		"jsdom": "^29.1.1",
		"msw": "^2.15.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	},
	"pnpm": {
		"overrides": {
			"@sveltejs/kit": "2.70.2",
			"ajv@^6.0.0": "6.14.0",
			"ajv@^8.0.0": "8.18.0",
			"brace-expansion@^5.0.0": "5.0.9",
			"cookie": "0.7.2",
			"devalue": "5.9.0",
			"dompurify": "3.4.12",
			"esbuild": "0.28.1",
			"fast-xml-parser": "5.10.1",
			"linkify-it": "5.0.2",
			"markdown-it": "14.2.0",
			"mdast-util-to-hast": "13.2.1",
			"picomatch@^2.0.0": "2.3.2",
			"picomatch@^4.0.0": "4.0.5",
			"postcss": "8.5.25",
			"rollup": "4.62.3",
			"sharp": "0.35.3",
			"svelte": "5.56.8",
			"undici@^7.0.0": "7.29.0"
		}
	}
}
